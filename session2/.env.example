# Copy this file to  .env  (same folder) and fill in YOUR values.
# These are the exact key names the Nubra SDK reads (docs: "Using .env Variables").
# NEVER commit .env, never paste it in chat, never put it on a slide.
#
# Two environments, two copies:
#   session2/.env        -> your UAT (sandbox) login: only needed for  screener.py --trade  and the demo
#   session2/prod/.env   -> your PROD login: market DATA (candles + live stream). Read-only in this workshop.
# The MPINs can differ between UAT and PROD; each folder keeps its own token file (auth_data.db*).
PHONE_NO="0000000000"
MPIN="0000"
